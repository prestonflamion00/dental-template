// Cloudflare Workers config for the demos site: every practice + the public examples
// page + the private hub (built by `npm run build:all` into site/).
// Cloudflare: Build command `npm run build:all`, Deploy command `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demos",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
