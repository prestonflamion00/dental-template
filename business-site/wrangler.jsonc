// Butterbite's own business website: plain static files in public/, no build step.
// Cloudflare Worker settings: Path "/business-site", no build command,
// Deploy command "npx wrangler@4 deploy". Kept self-contained so it can move to its own repo later.
{
  "name": "butterbite-site",
  "compatibility_date": "2026-10-01",
  // Public site: keep the workers.dev address and per-branch preview links on.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
